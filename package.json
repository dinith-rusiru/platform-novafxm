{
  "name": "novafxm-platform",
  "version": "1.0.0",
  "private": true,
  "description": "NovaFXM frontend and backend workspace",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm --prefix frontend run dev:frontend",
    "dev:backend": "npm --prefix backend run dev:backend",
    "start": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  }
}
